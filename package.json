{
  "name": "clerk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "setup-db": "node scripts/create-dynamodb-tables.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "coverage:open": "start coverage/lcov-report/index.html",
    "coverage:check": "jest --coverage --coverageReporters=text-summary --collectCoverageFrom=\"app/**/*.{js,jsx,ts,tsx}\" --collectCoverageFrom=\"components/**/*.{js,jsx,ts,tsx}\" --collectCoverageFrom=\"lib/**/*.{js,jsx,ts,tsx}\" --collectCoverageFrom=\"hooks/**/*.{js,jsx,ts,tsx}\" --collectCoverageFrom=\"!**/*.d.ts\" --collectCoverageFrom=\"!**/node_modules/**\" --collectCoverageFrom=\"!**/.next/**\" --collectCoverageFrom=\"!**/coverage/**\" --collectCoverageFrom=\"!**/tests/**\" --testMatch=\"<rootDir>/tests/unit/**/*.test.{js,jsx,ts,tsx}\"",
    "test:unit": "jest --testPathPatterns=tests/unit",
    "test:integration": "jest --config jest.config.integration.js",
    "test:components": "jest --testPathPatterns=tests/components",
    "test:api": "jest --config jest.config.node.js",
    "test:database": "jest --config jest.config.database.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:accessibility": "jest --testPathPatterns=tests/accessibility",
    "test:accessibility:e2e": "playwright test tests/e2e/accessibility.spec.ts",
    "test:accessibility:all": "npm run test:accessibility && npm run test:accessibility:e2e",
    "test:performance": "jest --testPathPatterns=tests/performance",
    "test:performance:e2e": "playwright test tests/e2e/performance.spec.ts",
    "test:performance:lighthouse": "lhci autorun",
    "test:performance:monitor": "node scripts/performance-monitor.js",
    "test:performance:monitor:ci": "node scripts/test-performance-monitor.js",
    "test:performance:all": "npm run test:performance && npm run test:performance:e2e",
    "test:all": "npm run test && npm run test:api && npm run test:e2e",
    "quality:report": "node scripts/quality-report-generator.js",
    "quality:gates": "npm run test:coverage && npm run test:performance:monitor:ci && npm run quality:report"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.11",
    "@ai-sdk/openai": "^2.0.23",
    "@ai-sdk/react": "^2.0.30",
    "@auth/dynamodb-adapter": "^2.10.0",
    "@aws-sdk/client-dynamodb": "^3.890.0",
    "@aws-sdk/lib-dynamodb": "^3.890.0",
    "@modelcontextprotocol/sdk": "^1.17.5",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
